DOMAIN=marketplace.example.com
DJANGO_SETTINGS_MODULE=config.production
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-generated-random-secret
DJANGO_ALLOWED_HOSTS=marketplace.example.com,backend
FRONTEND_URL=https://marketplace.example.com
CSRF_TRUSTED_ORIGINS=https://marketplace.example.com
CORS_ALLOWED_ORIGINS=https://marketplace.example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
POSTGRES_DB=admint
POSTGRES_USER=admint_admin
POSTGRES_PASSWORD=replace-with-a-generated-database-password
APP_DATABASE_USER=admint
APP_DATABASE_PASSWORD=replace-with-a-generated-application-database-password
CACHE_URL=redis://cache:6379/0
