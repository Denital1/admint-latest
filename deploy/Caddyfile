{$DOMAIN} {
    handle /static/* {
        root * /srv
        file_server
    }
    handle /api/* {
        reverse_proxy backend:8000 {
            header_up X-AdMint-Client-IP {remote_host}
        }
    }
    handle /admin/* {
        reverse_proxy backend:8000 {
            header_up X-AdMint-Client-IP {remote_host}
        }
    }
    handle {
        reverse_proxy frontend:3000
    }
}
